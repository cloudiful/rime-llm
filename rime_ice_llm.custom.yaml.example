# Copy this file to the Rime user directory as rime_ice_llm.custom.yaml only
# when you want to override the schema defaults.
prediction:
  enabled: true
  endpoint: http://127.0.0.1:32123
  mode: free
  trigger: ""
  idle_delay_ms: 200
  max_candidates: 5
  max_tokens: 8
  timeout_ms: 15000

llm_candidate_translator:
  max_paths: 128
  max_homophones: 8
